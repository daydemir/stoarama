{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stoarama-joined-folder-zip",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 300000 },
  "r2_buckets": [{ "binding": "JOINED", "bucket_name": "stoarama" }],
  "durable_objects": { "bindings": [{ "name": "ARCHIVE_LIMITER", "class_name": "ArchiveLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArchiveLimiter"] }],
  "vars": { "BACKEND_MANIFEST_URL": "https://stoarama.com/api/v1/recording/joined/archive/manifest" }
}
