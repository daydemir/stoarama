SERVICE_TOKEN=__set_me__
R2_ACCOUNT_ID=__set_me__
R2_ACCESS_KEY_ID=__set_me__
R2_SECRET_ACCESS_KEY=__set_me__
R2_BUCKET=__set_me__
R2_REGION=auto
APP_BASE_URL=https://example.com
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@example.com
EMAIL_REPLY_TO=support@example.com
EMAIL_RESEND_API_KEY=__set_me__
MIT_SCL_RECORDINGS_READ_ACCOUNT_ID=
# URL segment under /shared/ and /api/v1/shared/.
MIT_SCL_RECORDINGS_READ_SLUG=mit-scl
MIT_SCL_RECORDINGS_READ_PASSWORD=
# Independent server-side secret (32+ characters); rotating it logs out viewers.
MIT_SCL_RECORDINGS_COOKIE_SIGNING_KEY=
# Optional. Unset safely ignores forwarded headers; do not use a public catch-all.
MIT_SCL_RECORDINGS_TRUSTED_PROXY_CIDRS=
