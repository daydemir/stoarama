# Required
DATABASE_URL=postgres://social_isolation:social_isolation@localhost:54329/social_isolation?sslmode=disable
API_TOKEN=replace-me

# Migrations
AUTO_MIGRATE=true
MIGRATION_DIR=../infra/sql/migrations
PORT=8080

# Optional read-only MIT SCL recordings dashboard. Public mode removes the
# password gate but preserves account scoping and exposes no mutation routes.
MIT_SCL_RECORDINGS_PUBLIC=false
MIT_SCL_RECORDINGS_READ_ACCOUNT_ID=
# URL segment under /shared/ and /api/v1/shared/.
MIT_SCL_RECORDINGS_READ_SLUG=mit-scl
MIT_SCL_RECORDINGS_READ_PASSWORD=
# Independent server-side secret (32+ characters); rotating it logs out viewers.
MIT_SCL_RECORDINGS_COOKIE_SIGNING_KEY=
# Optional. When unset, rate limiting safely uses the direct peer and ignores
# forwarded headers. Set only known reverse-proxy CIDRs for per-client limits.
MIT_SCL_RECORDINGS_TRUSTED_PROXY_CIDRS=

# R2 (Cloudflare)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
# Optional override (useful for local MinIO)
R2_ENDPOINT=

# Signed URL TTLs
R2_SIGN_GET_TTL=10m
R2_SIGN_PUT_TTL=15m

# Capture worker
CAPTURE_TICK_SEC=5
CAPTURE_LEASE_SEC=90
WORKER_ID=capture-worker-1

# Joined delivery worker (ship-dark). Render instance count is the only cloud
# concurrency control; automatic rolling remains separately disabled.
JOINED_RECORDING_ENABLED=false
JOINED_RECORDING_CONTROL_PLANE_ENABLED=false
JOINED_RECORDING_PROTOCOL_VERSION=0
JOINED_RECORDING_ROLLING_ENABLED=false
JOINED_RECORDING_BATCH_ID=
JOINED_RECORDING_CANARY_HOUR_IDS=
STOARAMA_JOINED_WORK_SCOPE=disabled
JOINED_RECORDING_SCRATCH_ROOT=/tmp/stoarama-joined
JOINED_RECORDING_STORAGE_AUTHORITY=
JOINED_RECORDING_FFMPEG_ARCHIVE_URL=
JOINED_RECORDING_FFMPEG_ARCHIVE_SHA256=
JOINED_RECORDING_FFMPEG_BINARY_SHA256=
JOINED_RECORDING_FFPROBE_BINARY_SHA256=
STOARAMA_JOINED_WORKER_TOKEN=
JOINED_WORKER_BOOTSTRAP_TOKEN=
JOINED_WORKER_SIGNING_KEY=
STOARAMA_JOINED_OPERATOR_TOKEN=
