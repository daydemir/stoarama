#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  printf 'install-dev-hooks: run inside the Stoarama repository\n' >&2
  exit 1
}
cd "$root"

current="$(git config --get core.hooksPath || true)"
if [[ -n "$current" && "$current" != ".githooks" ]]; then
  printf 'install-dev-hooks: refusing effective core.hooksPath=%s; migrate it explicitly first\n' "$current" >&2
  exit 1
fi

legacy_hook="$(git rev-parse --git-path hooks/pre-push)"
repo_hook="$root/.githooks/pre-push"
if [[ -e "$legacy_hook" ]] && ! cmp -s "$legacy_hook" "$repo_hook"; then
  printf 'install-dev-hooks: refusing to disable existing %s; migrate it explicitly first\n' "$legacy_hook" >&2
  exit 1
fi

git config --local core.hooksPath .githooks
printf 'install-dev-hooks: installed repo-local pre-push verifier\n'
