[Unit]
Description=Durham direct R2 stitch worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stoarama-stitch
Group=stoarama-stitch
StateDirectory=stoarama-durham-stitch
StateDirectoryMode=0700
Environment=STOARAMA_STATE_DIR=/var/lib/stoarama-durham-stitch
Environment=STOARAMA_STITCH_MIN_MEMORY_BYTES=536870912
Environment=STOARAMA_STITCH_MAX_LOAD_PER_CPU=1.5
EnvironmentFile=/etc/stoarama-stitch/worker.env
UnsetEnvironment=QEMU_LD_PREFIX QEMU_CPU LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
LoadCredential=stoarama-api-key:/etc/stoarama-stitch/stoarama-api-key
ExecStart=/usr/bin/python3 -E -s -B /opt/stoarama-stitch/durham_stitch.py
Restart=on-failure
RestartSec=15s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
